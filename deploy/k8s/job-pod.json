{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "labels": {
      "app.kubernetes.io/name": "robo-worker",
      "app.kubernetes.io/component": "job"
    }
  },
  "spec": {
    "backoffLimit": 0,
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "robo-worker",
          "app.kubernetes.io/component": "job"
        }
      },
      "spec": {
        "restartPolicy": "Never",
        "automountServiceAccountToken": false,
        "enableServiceLinks": false,
        "terminationGracePeriodSeconds": 60,
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 10001,
          "runAsGroup": 10001,
          "fsGroup": 10001,
          "fsGroupChangePolicy": "OnRootMismatch",
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "job",
            "args": [
              "job",
              "--config",
              "/etc/robo-worker/config/config.toml"
            ],
            "resources": {
              "requests": {
                "cpu": "500m",
                "memory": "1Gi"
              },
              "limits": {
                "cpu": "2",
                "memory": "4Gi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "volumeMounts": [
              {
                "name": "state",
                "mountPath": "/state",
                "subPath": "set-by-the-launcher"
              },
              {
                "name": "work",
                "mountPath": "/work",
                "subPath": "set-by-the-launcher"
              },
              {
                "name": "config",
                "mountPath": "/etc/robo-worker/config",
                "readOnly": true
              },
              {
                "name": "gh",
                "mountPath": "/etc/robo-worker/gh",
                "readOnly": true
              },
              {
                "name": "git",
                "mountPath": "/etc/robo-worker/git",
                "readOnly": true
              },
              {
                "name": "token",
                "mountPath": "/run/robo-worker/token",
                "readOnly": true
              },
              {
                "name": "tmp",
                "mountPath": "/tmp"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "work",
            "persistentVolumeClaim": {
              "claimName": "robo-worker-work"
            }
          },
          {
            "name": "state",
            "persistentVolumeClaim": {
              "claimName": "robo-worker-state"
            }
          },
          {
            "name": "config",
            "configMap": {
              "name": "robo-worker-config"
            }
          },
          {
            "name": "gh",
            "secret": {
              "secretName": "robo-worker-gh",
              "defaultMode": 288
            }
          },
          {
            "name": "git",
            "secret": {
              "secretName": "robo-worker-git",
              "defaultMode": 288
            }
          },
          {
            "name": "token",
            "secret": {
              "secretName": "set-by-the-launcher",
              "defaultMode": 288
            }
          },
          {
            "name": "tmp",
            "emptyDir": {}
          }
        ]
      }
    }
  }
}
