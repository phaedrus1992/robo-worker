[Unit]
Description=robo-worker: claude -p jobs over MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=robo-worker
Group=robo-worker
WorkingDirectory=/home/robo-worker/robo-worker
Environment=PATH=/home/robo-worker/.local/bin:/home/robo-worker/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/robo-worker/robo-worker/.venv/bin/robo-worker --config /home/robo-worker/config.toml
Restart=on-failure
RestartSec=10
# Stop claude children with the service; the next start resumes them with --resume.
KillMode=control-group
TimeoutStopSec=60
# The worker runs with bypassPermissions, so it must not gain root through sudo or setuid.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/robo-worker
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
